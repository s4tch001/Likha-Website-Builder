<UserControl x:Class="WebsiteBuilder.App.Views.Panels.AssetsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:WebsiteBuilder.App.ViewModels.Panels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:AssetsViewModel}"
             Background="{StaticResource App.Surface}">
    <DockPanel>
        <TextBlock DockPanel.Dock="Top" Style="{StaticResource PanelHeaderText}" Text="ASSETS" />

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6,2,6,4">
            <Button Content="Import" Style="{StaticResource RibbonButton}"
                    ToolTip="Import files into the project's Assets folder"
                    Command="{Binding ImportCommand}" />
        </StackPanel>

        <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource MutedText}"
                   Text="{Binding Status}" FontSize="11" Margin="6,2,6,4" TextWrapping="Wrap" />

        <Grid>
            <ListBox ItemsSource="{Binding Assets}"
                     Background="Transparent" BorderThickness="0"
                     HorizontalContentAlignment="Stretch"
                     Foreground="{StaticResource App.Foreground}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="2,1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="#2C3340" CornerRadius="3"
                                    Padding="5,1" Margin="0,0,6,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Kind}" FontSize="10" Foreground="#9CC3FF" />
                            </Border>

                            <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{StaticResource App.Foreground}"
                                       ToolTip="{Binding RelativePath}" />

                            <Button Grid.Column="2" Content="✕" Width="20" Height="20" Padding="0" FontSize="11"
                                    Style="{StaticResource RibbonButton}" ToolTip="Delete asset"
                                    Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                    CommandParameter="{Binding}" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock Style="{StaticResource MutedText}"
                       Text="No assets yet. Click Import to add images, video, fonts…"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       TextAlignment="Center" TextWrapping="Wrap" Margin="16"
                       Visibility="{Binding Assets.Count, Converter={StaticResource ZeroToVis}}" />
        </Grid>
    </DockPanel>
</UserControl>
