<UserControl x:Class="WebsiteBuilder.App.Views.Panels.ComponentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:WebsiteBuilder.App.ViewModels.Panels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ComponentsViewModel}"
             Background="{StaticResource App.Surface}">
    <DockPanel>
        <TextBlock DockPanel.Dock="Top" Style="{StaticResource PanelHeaderText}" Text="COMPONENTS" />
        <TextBox DockPanel.Dock="Top"
                 Margin="8,0,8,8"
                 Style="{StaticResource SearchBox}"
                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Groups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,8">
                            <TextBlock Text="{Binding Name}" Style="{StaticResource PanelHeaderText}" />
                            <ItemsControl ItemsSource="{Binding Items}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="6,4"
                                                ToolTip="{Binding ToolTip}"
                                                Cursor="Hand"
                                                PreviewMouseLeftButtonDown="Component_OnPreviewMouseLeftButtonDown"
                                                PreviewMouseMove="Component_OnPreviewMouseMove">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Width" Value="82" />
                                                    <Setter Property="Height" Value="72" />
                                                    <Setter Property="Padding" Value="5" />
                                                    <Setter Property="Background" Value="{StaticResource App.Background}" />
                                                    <Setter Property="BorderBrush" Value="{StaticResource App.Border}" />
                                                    <Setter Property="BorderThickness" Value="1" />
                                                    <Setter Property="CornerRadius" Value="6" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsBlock}" Value="True">
                                                            <Setter Property="Width" Value="174" />
                                                            <Setter Property="Height" Value="122" />
                                                            <Setter Property="Padding" Value="10" />
                                                            <Setter Property="Background" Value="#202631" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Border.InputBindings>
                                                <MouseBinding MouseAction="LeftClick"
                                                              Command="{Binding DataContext.InsertCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                              CommandParameter="{Binding}" />
                                            </Border.InputBindings>
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Glyph}" FontSize="18"
                                                           HorizontalAlignment="Center"
                                                           Foreground="{StaticResource App.Foreground}" />
                                                <TextBlock Text="{Binding DisplayName}" FontSize="10"
                                                           Margin="0,4,0,0"
                                                           HorizontalAlignment="Center"
                                                           TextAlignment="Center"
                                                           TextWrapping="Wrap"
                                                           Foreground="{StaticResource App.ForegroundMuted}" />
                                                <TextBlock Text="BLOCK" FontSize="8" Margin="0,2,0,0"
                                                           Foreground="#93C5FD"
                                                           Visibility="{Binding IsBlock, Converter={StaticResource BoolToVis}}" />
                                                <TextBlock Text="{Binding Category}" FontSize="9" Margin="0,2,0,0"
                                                           Foreground="#60A5FA" HorizontalAlignment="Center"
                                                           Visibility="{Binding IsBlock, Converter={StaticResource BoolToVis}}" />
                                                <TextBlock Text="{Binding Description}" FontSize="9" Margin="2,3,2,0"
                                                           MaxHeight="30" TextTrimming="CharacterEllipsis"
                                                           TextAlignment="Center" TextWrapping="Wrap"
                                                           Foreground="{StaticResource App.ForegroundMuted}"
                                                           Visibility="{Binding IsBlock, Converter={StaticResource BoolToVis}}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
