<UserControl x:Class="WebsiteBuilder.App.Views.CanvasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:WebsiteBuilder.App.ViewModels"
             xmlns:views="clr-namespace:WebsiteBuilder.App.Views"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:CanvasViewModel}"
             Background="{StaticResource App.Background}">
    <DockPanel>

        <!-- Responsive + zoom toolbar -->
        <Border DockPanel.Dock="Top" Background="{StaticResource App.Surface}"
                BorderBrush="{StaticResource App.Border}" BorderThickness="0,0,0,1" Height="40">
            <Grid Margin="10,0">
                <!-- Editor connection status -->
                <TextBlock HorizontalAlignment="Left" VerticalAlignment="Center"
                           MaxWidth="420" TextTrimming="CharacterEllipsis"
                           Style="{StaticResource MutedText}"
                           Text="{Binding EditorStatus}" />

                <!-- Breakpoint switcher -->
                <ItemsControl ItemsSource="{Binding Breakpoints}" HorizontalAlignment="Center"
                              VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource RibbonButton}"
                                    Content="{Binding Label}"
                                    Command="{Binding DataContext.SetBreakpointCommand,
                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Zoom controls -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Style="{StaticResource RibbonButton}" Content="–" Command="{Binding ZoomOutCommand}" />
                    <TextBlock VerticalAlignment="Center" Width="48" TextAlignment="Center"
                               Foreground="{StaticResource App.Foreground}"
                               Text="{Binding Zoom, StringFormat={}{0:0}%}" />
                    <Button Style="{StaticResource RibbonButton}" Content="+" Command="{Binding ZoomInCommand}" />
                    <Border Style="{StaticResource RibbonSeparator}" />
                    <Button Style="{StaticResource RibbonButton}" Content="Reset" Command="{Binding ZoomResetCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Canvas surface: the WebView2-hosted React editor -->
        <views:EditorHostControl />
    </DockPanel>
</UserControl>
