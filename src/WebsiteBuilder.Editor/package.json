{
  "name": "websitebuilder-editor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "React/TypeScript visual editor hosted inside the WebsiteBuilder WPF app via WebView2.",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3000",
    "build": "next build && node scripts/copy-static-export.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "typescript": "7.0.2",
    "vitest": "4.1.9"
  }
}
